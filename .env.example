# Copy to .env and adjust. Values here are for local development only.

# On Linux, set this to your user id (`id -u`) so files Airflow writes are owned by you.
AIRFLOW_UID=50000

AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_JWT_SECRET=change-me-local-only
FERNET_KEY=

WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_DB=warehouse

RAW_RETENTION_DAYS=30
